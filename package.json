{
  "name": "@farishan-labs/design-tokens",
  "version": "0.1.0",
  "description": "W3C DTCG design tokens for Faris Han Labs (web, TUI, native).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/farishan-labs/design-tokens.git"
  },
  "files": [
    "src",
    "scripts",
    "PHILOSOPHY.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens/tokens.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun run typecheck && bun run gen:tokens",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "check": "bun run lint && bun run fmt:check && bun run typecheck",
    "gen:tokens": "bun run scripts/gen-tokens.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "bun": ">=1.0.0"
  }
}
