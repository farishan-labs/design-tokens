{
  "color": {
    "bg": {
      "default": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        }
      },
      "muted": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.956863, 0.956863, 0.960784],
          "hex": "#f4f4f5"
        }
      },
      "inverse": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.035294, 0.035294, 0.043137],
          "hex": "#09090b"
        }
      }
    },
    "fg": {
      "default": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.035294, 0.035294, 0.043137],
          "hex": "#09090b"
        }
      },
      "muted": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.443137, 0.443137, 0.478431],
          "hex": "#71717a"
        }
      },
      "inverse": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.980392, 0.980392, 0.980392],
          "hex": "#fafafa"
        }
      }
    },
    "border": {
      "default": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.894118, 0.894118, 0.905882],
          "hex": "#e4e4e7"
        }
      },
      "strong": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.631373, 0.631373, 0.666667],
          "hex": "#a1a1aa"
        }
      }
    },
    "accent": {
      "default": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.145098, 0.388235, 0.921569],
          "hex": "#2563eb"
        }
      },
      "hover": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.113725, 0.305882, 0.847059],
          "hex": "#1d4ed8"
        }
      },
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        }
      }
    },
    "danger": {
      "default": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.862745, 0.14902, 0.14902],
          "hex": "#dc2626"
        }
      },
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        }
      }
    },
    "success": {
      "default": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.086275, 0.639216, 0.290196],
          "hex": "#16a34a"
        }
      },
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        }
      }
    }
  },
  "space": {
    "0": {
      "$type": "dimension",
      "$value": {
        "value": 0,
        "unit": "px"
      }
    },
    "1": {
      "$type": "dimension",
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "2": {
      "$type": "dimension",
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "3": {
      "$type": "dimension",
      "$value": {
        "value": 0.75,
        "unit": "rem"
      }
    },
    "4": {
      "$type": "dimension",
      "$value": {
        "value": 1,
        "unit": "rem"
      }
    },
    "6": {
      "$type": "dimension",
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    },
    "8": {
      "$type": "dimension",
      "$value": {
        "value": 2,
        "unit": "rem"
      }
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": {
        "value": 0.25,
        "unit": "rem"
      }
    },
    "md": {
      "$type": "dimension",
      "$value": {
        "value": 0.375,
        "unit": "rem"
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": {
        "value": 0.5,
        "unit": "rem"
      }
    },
    "full": {
      "$type": "dimension",
      "$value": {
        "value": 9999,
        "unit": "px"
      }
    }
  },
  "font": {
    "family": {
      "sans": {
        "$type": "fontFamily",
        "$value": "ui-sans-serif, system-ui, -apple-system, sans-serif"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "ui-monospace, SFMono-Regular, Menlo, monospace"
      }
    },
    "size": {
      "xs": {
        "$type": "dimension",
        "$value": {
          "value": 0.75,
          "unit": "rem"
        }
      },
      "sm": {
        "$type": "dimension",
        "$value": {
          "value": 0.875,
          "unit": "rem"
        }
      },
      "md": {
        "$type": "dimension",
        "$value": {
          "value": 1,
          "unit": "rem"
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": {
          "value": 1.125,
          "unit": "rem"
        }
      },
      "xl": {
        "$type": "dimension",
        "$value": {
          "value": 1.25,
          "unit": "rem"
        }
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": "semi-bold"
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700
      }
    }
  },
  "motion": {
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": {
          "value": 100,
          "unit": "ms"
        }
      },
      "normal": {
        "$type": "duration",
        "$value": {
          "value": 200,
          "unit": "ms"
        }
      },
      "slow": {
        "$type": "duration",
        "$value": {
          "value": 300,
          "unit": "ms"
        }
      }
    }
  },
  "shadow": {
    "sm": {
      "$type": "shadow",
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.0, 0.0, 0.0],
          "hex": "#000000",
          "alpha": 0.05
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 1,
          "unit": "px"
        },
        "blur": {
          "value": 2,
          "unit": "px"
        },
        "spread": {
          "value": 0,
          "unit": "px"
        },
        "inset": false
      }
    },
    "md": {
      "$type": "shadow",
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.0, 0.0, 0.0],
          "hex": "#000000",
          "alpha": 0.1
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 4,
          "unit": "px"
        },
        "blur": {
          "value": 6,
          "unit": "px"
        },
        "spread": {
          "value": -1,
          "unit": "px"
        },
        "inset": false
      }
    }
  },
  "easing": {
    "standard": {
      "$type": "cubicBezier",
      "$value": [0.4, 0.0, 0.2, 1.0]
    },
    "decelerate": {
      "$type": "cubicBezier",
      "$value": [0.0, 0.0, 0.2, 1.0]
    },
    "accelerate": {
      "$type": "cubicBezier",
      "$value": [0.4, 0.0, 1.0, 1.0]
    }
  },
  "opacity": {
    "disabled": {
      "$type": "number",
      "$value": 0.38
    },
    "hover": {
      "$type": "number",
      "$value": 0.08
    }
  },
  "border": {
    "default": {
      "$type": "border",
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.894118, 0.894118, 0.905882],
          "hex": "#e4e4e7"
        },
        "width": {
          "value": 1,
          "unit": "px"
        },
        "style": "solid"
      }
    },
    "strong": {
      "$type": "border",
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [0.631373, 0.631373, 0.666667],
          "hex": "#a1a1aa"
        },
        "width": {
          "value": 2,
          "unit": "px"
        },
        "style": "solid"
      }
    }
  },
  "strokeStyle": {
    "solid": {
      "$type": "strokeStyle",
      "$value": "solid"
    },
    "dashed": {
      "$type": "strokeStyle",
      "$value": "dashed"
    },
    "custom": {
      "$type": "strokeStyle",
      "$value": {
        "dashArray": [
          {
            "value": 4,
            "unit": "px"
          },
          {
            "value": 2,
            "unit": "px"
          }
        ],
        "lineCap": "round"
      }
    }
  },
  "transition": {
    "fast": {
      "$type": "transition",
      "$value": {
        "duration": {
          "value": 150,
          "unit": "ms"
        },
        "timingFunction": [0.4, 0.0, 0.2, 1.0],
        "delay": {
          "value": 0,
          "unit": "ms"
        }
      }
    }
  },
  "gradient": {
    "brand": {
      "$type": "gradient",
      "$value": [
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.145098, 0.388235, 0.921569],
            "hex": "#2563eb"
          },
          "position": 0.0
        },
        {
          "color": {
            "colorSpace": "srgb",
            "components": [0.113725, 0.305882, 0.847059],
            "hex": "#1d4ed8"
          },
          "position": 1.0
        }
      ]
    }
  },
  "typography": {
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "ui-sans-serif, system-ui, -apple-system, sans-serif",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        },
        "fontWeight": 400,
        "lineHeight": 1.5,
        "letterSpacing": {
          "value": 0,
          "unit": "rem"
        }
      }
    }
  },
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json"
}
