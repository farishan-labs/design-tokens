{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "accent": {
      "default": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.929412, 0.929412, 0.929412],
          "hex": "#ededed"
        }
      },
      "hover": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        }
      },
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.070588, 0.070588, 0.070588],
          "hex": "#121212"
        }
      }
    }
  }
}
