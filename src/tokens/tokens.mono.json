{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "accent": {
      "default": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.078431, 0.078431, 0.078431],
          "hex": "#141414"
        }
      },
      "hover": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [0.0, 0.0, 0.0],
          "hex": "#000000"
        }
      },
      "fg": {
        "$type": "color",
        "$value": {
          "colorSpace": "srgb",
          "components": [1.0, 1.0, 1.0],
          "hex": "#ffffff"
        }
      }
    }
  }
}
